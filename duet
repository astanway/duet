#!/usr/bin/env python3
"""duet: one shared conversation between you, Claude Code and Codex.

Run `duet` in a project directory. It opens the room for that directory (.duet/chat.md, created
on first use) and drops you into a prompt. Every time an analyst takes a turn it is handed the
entire log as context and its reply is appended, so both analysts always see exactly the same
conversation. You direct work to either of them (@claude, @codex) or to both. Nothing is held in
hidden per-agent sessions; the log on disk is the whole state and you can edit it between turns.

Both CLIs run with API-key environment variables stripped so they bill to the logged-in
subscriptions (claude.ai / ChatGPT), never to API keys.
"""
from __future__ import annotations

import argparse
import datetime as dt
import json
import os
import re
import subprocess
import sys
import time
from pathlib import Path
from string import Template

HERE = Path(__file__).resolve().parent
PROMPTS = HERE / "prompts"
ROOM_DIR = ".duet"
GLOBAL_DIR = Path.home() / ".duet"
PERSONA_FILE = "personalization.md"

DISPLAY = {"claude": "Claude", "codex": "Codex", "human": "Human"}
OTHER = {"claude": "codex", "codex": "claude"}
AGENTS = ("claude", "codex")
WRITE_TOOLS = ["Edit", "Write", "MultiEdit", "NotebookEdit"]
STRIP_ENV = ("ANTHROPIC_API_KEY", "OPENAI_API_KEY", "CLAUDECODE", "CLAUDE_CODE_ENTRYPOINT")
STATUS_RE = re.compile(r"^\s*\**STATUS\**\s*:\s*\**\s*(WAITING|CONTINUE)\b", re.I | re.M)
ENTRY_RE = re.compile(r"^### \[(?P<n>\d+)\] (?P<who>Human|Claude|Codex)(?P<addr>.*)$", re.M)
FAKE = os.environ.get("DUET_FAKE") == "1"


class AgentError(RuntimeError):
    pass


def child_env(keep_keys: bool) -> dict:
    env = dict(os.environ)
    for k in STRIP_ENV:
        if keep_keys and k.endswith("_API_KEY"):
            continue
        env.pop(k, None)
    # A headless turn ends when the agent replies; nothing can deliver background results after that.
    # Keep delegation in the foreground so subagents finish inside the turn.
    env.setdefault("CLAUDE_CODE_DISABLE_BACKGROUND_TASKS", "1")
    env.setdefault("CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS", "0")
    return env


def now() -> str:
    return dt.datetime.now().astimezone().isoformat(timespec="seconds")


def hr(title: str = "", ch: str = "─") -> str:
    return f"{ch * 4} {title} {ch * max(4, 72 - len(title))}" if title else ch * 78


def render(name: str, **kw) -> str:
    return Template((PROMPTS / f"{name}.md").read_text()).safe_substitute(kw).strip() + "\n"


def personalization(room_path: Path) -> dict:
    """Standing instructions from the human: global (every room) and per project. Read fresh each turn."""
    out = {}
    for scope, f in (("global", GLOBAL_DIR / PERSONA_FILE), ("project", room_path / PERSONA_FILE)):
        try:
            out[scope] = f.read_text().strip()
        except OSError:
            out[scope] = ""
    return out


def save_personalization(room_path: Path, scope: str, text: str):
    f = (GLOBAL_DIR if scope == "global" else room_path) / PERSONA_FILE
    f.parent.mkdir(parents=True, exist_ok=True)
    f.write_text(text.strip() + ("\n" if text.strip() else ""))


UNTITLED = "duet room"
TITLE_RE = re.compile(r"^# (.*)$", re.M)


def title_of(text: str) -> str | None:
    m = TITLE_RE.search(text)
    t = m.group(1).strip() if m else ""
    return None if not t or t == UNTITLED else t


def name_conversation(context: str) -> str | None:
    """Ask Claude (haiku, no tools) for a short title. None on any failure."""
    if FAKE:
        return " ".join(context.split()[:5]).rstrip(".,:;") or None
    prompt = ("Give this conversation a title of 3 to 6 words, like a document name: specific to the subject matter, "
              "no quotes, no trailing period, Title Case. Output only the title.\n\n<conversation>\n"
              + context[:6000] + "\n</conversation>")
    try:
        p = subprocess.run(["claude", "-p", "--model", "haiku", "--restricted", "--no-session-persistence",
                            "--output-format", "json", "--permission-prompts", "none", "--disallowedTools", "*"],
                           input=prompt, text=True, capture_output=True, timeout=60, env=child_env(False))
        data = json.loads(p.stdout.strip().splitlines()[-1]) if p.stdout.strip() else {}
        t = (data.get("result") or "").strip().strip('"').splitlines()[0].strip() if not data.get("is_error") else ""
        return t[:80] or None
    except (OSError, ValueError, IndexError, subprocess.TimeoutExpired):
        return None


# --------------------------------------------------------------------------- permission tool

def permission_server(url: str):
    """Stdio MCP server with one tool, `permission`, that Claude Code calls when an action needs
    approval. Each call is forwarded to the duet web server, which shows it in the UI and waits
    for the human. Protocol: newline-delimited JSON-RPC 2.0."""
    import urllib.request

    def http(path: str, body: dict | None = None, timeout: float = 30) -> dict:
        req = urllib.request.Request(url + path, data=json.dumps(body).encode() if body is not None else None,
                                     headers={"Content-Type": "application/json"}, method="POST" if body is not None else "GET")
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return json.loads(r.read() or b"{}")

    def decide(args: dict) -> dict:
        tool, inp = args.get("tool_name") or "tool", args.get("input") or {}
        try:
            rid = http("/api/permission/request", {"tool_name": tool, "input": inp,
                                                   "summary": tool_summary(tool, inp)})["id"]
            deadline = time.time() + 30 * 60
            while time.time() < deadline:
                r = http(f"/api/permission/wait?id={rid}", timeout=40)
                if r.get("decided"):
                    if r.get("allow"):
                        return {"behavior": "allow", "updatedInput": inp}
                    return {"behavior": "deny", "message": r.get("message") or "The human declined this action."}
            return {"behavior": "deny", "message": "No answer from the human within 30 minutes."}
        except Exception as e:  # server gone, aborted turn, etc.
            return {"behavior": "deny", "message": f"Permission could not be requested: {e}"}

    out = sys.stdout
    for line in sys.stdin:
        try:
            msg = json.loads(line)
        except json.JSONDecodeError:
            continue
        mid, method, params = msg.get("id"), msg.get("method"), msg.get("params") or {}
        if method == "initialize":
            res = {"protocolVersion": params.get("protocolVersion") or "2025-06-18",
                   "capabilities": {"tools": {}}, "serverInfo": {"name": "duet", "version": "1"}}
        elif method == "tools/list":
            res = {"tools": [{"name": "permission", "description": "Ask the human in duet to allow or deny a tool use.",
                              "inputSchema": {"type": "object", "properties": {
                                  "tool_name": {"type": "string"}, "input": {"type": "object"},
                                  "tool_use_id": {"type": "string"}}, "required": ["tool_name", "input"]}}]}
        elif method == "tools/call":
            res = {"content": [{"type": "text", "text": json.dumps(decide(params.get("arguments") or {}))}]}
        elif method == "ping":
            res = {}
        elif mid is None:
            continue   # notification
        else:
            out.write(json.dumps({"jsonrpc": "2.0", "id": mid, "error": {"code": -32601, "message": "unknown method"}}) + "\n")
            out.flush()
            continue
        out.write(json.dumps({"jsonrpc": "2.0", "id": mid, "result": res}) + "\n")
        out.flush()


